# Supabase project (create your own project for party-games — do NOT reuse another app's).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. NEVER prefix with NEXT_PUBLIC_. The command pipeline uses this to call the
# state-writing RPCs, which are deliberately not executable by `anon` or `authenticated`.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional: Cloudflare Turnstile, protects anonymous sign-in from being an account factory.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
