# Supabase project (create your own project for party-games — do NOT reuse another app's).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only. NEVER prefix with NEXT_PUBLIC_. The command pipeline uses this to call the
# state-writing RPCs, which are deliberately not executable by `anon` or `authenticated`.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# hCaptcha. Strongly recommended: anonymous sign-in without one is an open
# account factory — a single unauthenticated POST mints a permanent auth user.
#
# Only the SITE key belongs here. The hCaptcha SECRET key goes into the Supabase
# dashboard (Authentication -> Attack Protection), because Supabase Auth is what
# calls hCaptcha's siteverify. This app never sees it and must never contain it.
#
# Turn both on together: with protection enabled in Supabase and no site key
# here, every guest sign-in is refused.
#
# hCaptcha's always-passing test key, for local development and CI:
#   10000000-ffff-ffff-ffff-000000000001
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
